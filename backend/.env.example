# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Linked-bot trading (do NOT commit the real values; backend/.env is git-ignored) ---
# Private key of the bot you linked in the dreamDEX app (0x + 64 hex characters).
DREAMDEX_BOT_PRIVATE_KEY=
# Your dreamDEX wallet address (the "Wallet 1" address that holds the margin).
DREAMDEX_OWNER_ADDRESS=
# The MetaMask account allowed to authorize actions.
DREAMDEX_REQUESTER_ADDRESS=
# Somnia Hideki testnet RPC.
SOMNIA_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
